NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/collabboard
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CLIENT_ORIGIN=http://localhost:5173

# Live video/voice calls (WebRTC). All optional.
# STUN is enough for most networks (default: Google's public STUN). Strict NATs / corporate firewalls need a TURN relay.
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# coturn with `use-auth-secret`: short-lived credentials are minted per user from this secret...
# TURN_SECRET=
# ...or a fixed account instead:
# TURN_USERNAME=
# TURN_CREDENTIAL=
