# Copy to .env (development) or set in your host's build settings (production).
# VITE_* values are inlined at BUILD time and are visible to anyone: never put secrets here.

# Origin of the API server, no trailing slash and no "/api".
#   Empty (default)  -> same origin as the page. Dev: the Vite proxy forwards /api and /socket.io.
#   https://api.example.com -> the browser talks to that server directly (needs CORS, see below).
# VITE_API_URL=

# Dev only (read by vite.config.js, not shipped to the browser):
# DEV_PROXY_TARGET=http://localhost:5000
# DEV_PORT=5173

# If VITE_API_URL points at a different origin, set the server's CLIENT_ORIGIN to this app's origin
# (comma-separated for several). Cookies: the refresh cookie is SameSite=Lax, so the app and the API
# must be on the same *site* (e.g. app.example.com + api.example.com); see README "Deploying".
